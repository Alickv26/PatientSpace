# PatientSpace local development environment.
# Copy to .env and adjust.

# Facility identifier (format: F-XXXXXXXX, base32 Crockford, no I/L/O/U).
PATIENTSPACE_FACILITY_ID=F-PETAUKE1

# Bind address for the facility (patientspace-core) HTTP server.
PATIENTSPACE_BIND=127.0.0.1:8080

# SQLite database URL. Use file::memory: for ephemeral, or a path for persistent.
PATIENTSPACE_DATABASE_URL=sqlite:patientspace.db?mode=rwc

# URL of the regional/national hub.
PATIENTSPACE_HUB_URL=https://hub.patientspace.org

# Bind address for the hub binary (patientspace-hub).
PATIENTSPACE_HUB_BIND=0.0.0.0:8081

# Logging level (RUST_LOG format).
RUST_LOG=info,patientspace=debug
